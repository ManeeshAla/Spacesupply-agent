# Copy to backend/.env and fill in your key.  backend/.env is git-ignored.
# Get a free key at https://aistudio.google.com/apikey

GEMINI_API_KEY=

# Free-tier models that support tool calling. The assistant drops to the fallback model when the
# primary is out of quota or overloaded, and then to the offline Micro LM. The bigger
# gemini-3.6-flash / gemini-3.8-flash are better but their free quota runs out almost immediately,
# so the lite models are the usable default -- try a flash model here if you have paid quota.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT_S=25
GEMINI_MAX_RETRIES=3

# Tool-calling rounds allowed per question, and user+assistant turns kept in memory.
MAX_TOOL_STEPS=6
CHAT_HISTORY_TURNS=8

# 1 = ask before the chat changes the simulation (recommended). 0 = run actions immediately.
CONFIRM_ACTIONS=1

