# Copy to backend/.env and fill in your key.  backend/.env is git-ignored.
# Get a free key at https://aistudio.google.com/apikey

GEMINI_API_KEY=

# Free-tier models that support tool calling. Flash is the primary; the assistant drops to
# the lite model when the free tier reports it is out of quota, and then to the offline Micro LM.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT_S=45
GEMINI_MAX_RETRIES=3

# Tool-calling rounds allowed per question, and user+assistant turns kept in memory.
MAX_TOOL_STEPS=6
CHAT_HISTORY_TURNS=8

# 1 = ask before the chat changes the simulation (recommended). 0 = run actions immediately.
CONFIRM_ACTIONS=1

